# =============================================================================
# Alfiqi Control — control panel environment
# Copy to .env and edit. Only DATA_DIR is strictly required.
# =============================================================================

# Where the control panel stores its own database, snapshots and workspaces.
DATA_DIR=./data

# Public URL of this control panel (used in agent commands & links).
# On Railway set it to the generated domain, e.g. https://alfiqi-control.up.railway.app
APP_URL=

# Strong random secret for JWT signing + secret encryption.
# Leave blank to auto-generate and persist in data/secret.key (recommended).
APP_SECRET=

# First-run owner (optional). If both are set, the account is created on boot.
# You can also create it from the setup screen.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Owner

# Secure cookies require HTTPS. Set to 1 on Railway/production, 0 for local HTTP.
COOKIE_SECURE=0
SESSION_DAYS=14

# Optional fictional demo workspace; keep disabled for a real bot.
DEMO_SEED=0

# Upload limit for a snapshot archive (MB).
MAX_UPLOAD_MB=2048

# Local retention: keep at most N snapshots per bot and/or N days.
KEEP_LAST_SNAPSHOTS=40
RETENTION_DAYS=30
BACKUP_STALE_HOURS=12

# Optional: restrict CORS (the SPA is same-origin, so usually unnecessary).
CORS_ORIGINS=

# =============================================================================
# Optional object storage (S3-compatible: Cloudflare R2 / Backblaze B2 / AWS S3).
# These can also be configured from Settings → Storage inside the panel.
# =============================================================================
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=alfiqi-backups
S3_KEEP_LOCAL=1
